# Public browser configuration. Values in NEXT_PUBLIC_* are shipped to clients
# and must never contain secrets.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=MixChat
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Production uses HTTPS/WSS origins. Keep these origins aligned with the
# backend FRONTEND_URL and the CSP connect-src policy in next.config.ts.
