# ==============================================================================
# MixChat Backend Environment Configuration Template
# ==============================================================================

# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api
FRONTEND_URL=http://localhost:3000
SWAGGER_ENABLED=true
TRUST_PROXY=false
BODY_LIMIT_KB=256

# PostgreSQL (Prisma 7)
DATABASE_URL=postgresql://mixchat:mixchat_dev_secret@localhost:5433/mixchat_db?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Redis
REDIS_URL=redis://localhost:6380

# Reverse geocoding (swap the base URL for a managed/self-hosted provider in
# larger production deployments; public Nominatim is limited to 1 req/sec).
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=MixChat/1.0 (support@mixchat.app)

# JWT & Auth Security
JWT_SECRET=mixchat_jwt_super_secret_development_key_32bytes_long
JWT_ACCESS_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION_DAYS=7
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Cloudflare R2 Object Storage (Phase 3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mixchat-media
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=104857600

# Browser Web Push
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# Production requirements:
# - Set NODE_ENV=production, SWAGGER_ENABLED=false, COOKIE_SECURE=true.
# - Replace JWT_SECRET with at least 32 cryptographically random characters;
#   startup rejects the development default in production.
# - Use managed TLS PostgreSQL/Redis URLs and size DATABASE_POOL_MAX across all
#   replicas so their combined connections remain below the database limit.
# - Set TRUST_PROXY=true only behind a trusted single reverse proxy that
#   overwrites forwarding headers.
# - Never commit populated R2 or VAPID credentials.
