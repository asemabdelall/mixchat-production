// Phase 13: Anonymous Matching & Safety Models
// ----------------------------------------------------

model AnonymousReport {
  id                 String   @id @default(uuid())
  reporterId         String   @map("reporter_id")
  reportedUserId     String   @map("reported_user_id")
  anonymousSessionId String   @map("anonymous_session_id")
  reason             String
  details            String?
  messageSnippets    Json?    @map("message_snippets")
  createdAt          DateTime @default(now()) @map("created_at")

  reporter     User @relation("ReporterAnonymousReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User @relation("ReportedAnonymousReports", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reportedUserId, createdAt])
  @@index([anonymousSessionId])
  @@map("anonymous_reports")
}

// ----------------------------------------------------
// Phase 14: Unified Reporting, Moderation & Mutes
// ----------------------------------------------------

enum ReportTargetType {
  USER
  POST
  COMMENT
  STORY
  REEL
  MESSAGE
  ANONYMOUS_SESSION
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_OR_ABUSE
  SEXUAL_CONTENT
  VIOLENCE
  SCAM_OR_FRAUD
  IMPERSONATION
  PRIVACY
  SELF_HARM
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  ACTIONED
  DISMISSED
}

enum ModerationActionType {
  DISMISS_REPORT
  REMOVE_CONTENT
  WARN_USER
  SUSPEND_USER
  DISABLE_USER
  RESTRICT_USER
}

model Report {
  id              String           @id @default(uuid())
  reporterId      String           @map("reporter_id")
  reporter        User             @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId  String           @map("reported_user_id")
  reportedUser    User             @relation("ReportedUserReports", fields: [reportedUserId], references: [id], onDelete: Cascade)
  targetType      ReportTargetType @map("target_type")
  targetId        String           @map("target_id")
  reason          ReportReason
  details         String?
  status          ReportStatus     @default(OPEN)
  priority        Int              @default(0)
  snapshot        Json?
  resolvedAt      DateTime?        @map("resolved_at")
  resolvedById    String?          @map("resolved_by_id")
  resolvedBy      User?            @relation("ResolverReports", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNotes String?          @map("resolution_notes")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  moderationActions ModerationAction[]

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([reportedUserId, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId, targetType, targetId])
  @@map("reports")
}

model ModerationAction {
  id           String               @id @default(uuid())
  moderatorId  String               @map("moderator_id")
  moderator    User                 @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: Cascade)
  action       ModerationActionType
  targetType   ReportTargetType     @map("target_type")
  targetId     String               @map("target_id")
  targetUserId String?              @map("target_user_id")
  targetUser   User?                @relation("TargetUserModerationActions", fields: [targetUserId], references: [id], onDelete: SetNull)
  reportId     String?              @map("report_id")
  report       Report?              @relation(fields: [reportId], references: [id], onDelete: SetNull)
  reason       String?
  metadata     Json?
  createdAt    DateTime             @default(now()) @map("created_at")

  @@index([targetType, targetId])
  @@index([moderatorId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("moderation_actions")
}

model Mute {
  id        String   @id @default(uuid())
  muterId   String   @map("muter_id")
  mutedId   String   @map("muted_id")
  createdAt DateTime @default(now()) @map("created_at")

  muter User @relation("UserMutes", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("UserMutedBy", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@index([muterId])
  @@index([mutedId])
  @@map("mutes")
}

// ----------------------------------------------------
// Phase 16: Voice & Video Calling Models
// ----------------------------------------------------

enum CallType {
  VOICE
  VIDEO
}

enum CallStatus {
  INITIATING
  RINGING
  ACTIVE
  ENDED
}

enum CallEndReason {
  COMPLETED
  DECLINED
  MISSED
  CANCELLED
  BUSY
  FAILED
  NO_ANSWER
}

enum CallParticipantStatus {
  INVITED
  RINGING
  ACCEPTED
  DECLINED
  LEFT
  MISSED
  BUSY
}

model CallSession {
  id              String         @id @default(uuid())
  conversationId  String         @map("conversation_id")
  conversation    Conversation   @relation("ConversationCalls", fields: [conversationId], references: [id], onDelete: Cascade)
  initiatorId     String         @map("initiator_id")
  initiator       User           @relation("UserInitiatedCalls", fields: [initiatorId], references: [id], onDelete: Cascade)
  type            CallType       @default(VOICE)
  status          CallStatus     @default(INITIATING)
  livekitRoomName String         @unique @map("livekit_room_name")
  ringingAt       DateTime?      @map("ringing_at")
  answeredAt      DateTime?      @map("answered_at")
  endedAt         DateTime?      @map("ended_at")
  durationSeconds Int            @default(0) @map("duration_seconds")
  endedByUserId   String?        @map("ended_by_user_id")
  endedByUser     User?          @relation("UserEndedCalls", fields: [endedByUserId], references: [id], onDelete: SetNull)
  endReason       CallEndReason? @map("end_reason")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  participants CallParticipant[]

  @@index([conversationId, createdAt, id])
  @@index([initiatorId, status])
  @@index([status, createdAt])
  @@map("call_sessions")
}

model CallParticipant {
  id        String                @id @default(uuid())
  callId    String                @map("call_id")
  call      CallSession           @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId    String                @map("user_id")
  user      User                  @relation("UserCallParticipations", fields: [userId], references: [id], onDelete: Cascade)
  status    CallParticipantStatus @default(INVITED)
  invitedAt DateTime              @default(now()) @map("invited_at")
  joinedAt  DateTime?             @map("joined_at")
  leftAt    DateTime?             @map("left_at")
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@unique([callId, userId])
  @@index([userId, status])
  @@index([callId])
  @@map("call_participants")
}
